# macOS
.DS_Store

# Xcode — user-specific state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Xcode — build output
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
# Note: Package.resolved is intentionally NOT ignored — this is an app, so it
# should be committed for reproducible dependency resolution once SPM deps exist.

# CocoaPods / Carthage (not used today, ignored pre-emptively)
Pods/
Carthage/Build/

# Agent hosts — personal overrides only. The shared config (settings.json,
# hooks.json, agents/, rules/, .codex/config.toml) is intentionally committed so
# every host behaves the same for everyone on the repo.
.claude/settings.local.json
.cursor/settings.local.json
.cursor/mcp.local.json
.codex/config.local.toml
AGENTS.override.md
# Codex hooks belong in .codex/config.toml only. Codex loads this file *and*
# config.toml and warns about the duplicate layer — see AGENTS.md.
.codex/hooks.json

# Create ML — local model-training scratch projects (no code references them
# yet; commit deliberately if one becomes a real asset).
*.mlproj/

# Editor — ignore personal VS Code/Cursor junk, but keep shared workspace
# settings so Even Better TOML can validate .codex/agents/*.toml.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.local.code-workspace
